<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <Target Name="PackageDab">
    <Error Condition="'$(DabOutput)' == ''" Text="DabOutput must name the deployment output directory." />
    <Exec Command="dotnet tool install --tool-path &quot;$(DabOutput)&quot; Microsoft.DataApiBuilder --version 2.1.5" />
    <Copy SourceFiles="dab-config.json;start-dab.sh" DestinationFolder="$(DabOutput)" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Linux'))" Command="sed -i 's/\r$//' &quot;$(DabOutput)/start-dab.sh&quot;" />
  </Target>
</Project>
