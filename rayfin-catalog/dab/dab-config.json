{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.1.5/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('SQL_CONNECTION_STRING')"
  },
  "runtime": {
    "rest": { "enabled": false, "path": "/rest" },
    "mcp": { "enabled": false },
    "graphql": { "enabled": true, "path": "/api/graphql", "allow-introspection": false, "depth-limit": 5 },
    "pagination": { "default-page-size": 12, "max-page-size": 50 },
    "host": {
      "mode": "production",
      "authentication": { "provider": "AppService" },
      "cors": { "origins": [], "allow-credentials": false }
    },
    "health": { "enabled": false }
  },
  "entities": {
    "Product": {
      "source": { "object": "dbo.CatalogProduct", "type": "table" },
      "graphql": { "enabled": true, "type": { "singular": "Product", "plural": "Products" } },
      "permissions": [{
        "role": "authenticated",
        "actions": [
          "read",
          { "action": "create", "fields": { "include": ["name", "category", "description"] } },
          { "action": "update", "fields": { "include": ["name", "category", "description"] } }
        ]
      }]
    }
  }
}
